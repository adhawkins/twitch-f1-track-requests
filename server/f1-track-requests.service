[Unit]
Description=F1 Track Requests server

[Service]
Type=simple
WorkingDirectory=%h/software/twitch-f1-track-requests/server
EnvironmentFile=-%h/software/twitch-f1-track-requests/server/f1-track-requests.env
ExecStart=/usr/bin/node server.js $EXTRA_ARGS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
